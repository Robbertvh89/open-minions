# Local development defaults (match deploy/compose.yml). Copy to .env.
MINION_DATABASE_URL=postgresql+asyncpg://minion:minion@localhost:5432/minion
MINION_S3_ENDPOINT_URL=http://localhost:9000
MINION_S3_ACCESS_KEY=minion
MINION_S3_SECRET_KEY=minion-secret
MINION_S3_BUCKET=minion
# MINION_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000   # host executors use; defaults to the above
# MINION_S3_REGION=us-east-1
# MINION_S3_INPUT_PREFIXES=["inputs/"]    # JSON list; each must end with "/"
# MINION_S3_OUTPUT_PREFIXES=["outputs/"]
# MINION_PRESIGN_TTL_S=900                # max 3600
# MINION_MODELS_FILE=deploy/models.yaml
# MINION_API_KEYS_FILE=deploy/api-keys.yaml
# MINION_SPLITTER_POLL_S=2
# MINION_EXECUTOR_TOKEN_TTL_DAYS=90
# MINION_DB_POOL_SIZE=10                 # pool_size + max_overflow = max DB connections per server
# MINION_WATCHDOG_DB_POOL_SIZE=2          # watchdog process DB pool
# MINION_DB_MAX_OVERFLOW=10              # process; size to the expected concurrent executor calls,
#                                        # and keep the sum below Postgres max_connections
# MINION_MAX_REQUEST_BODY_BYTES=1048576  # larger request bodies get 413
# MINION_SPLIT_MAX_LINE_BYTES=16777216   # longer JSONL line -> task FAILED (LINE_TOO_LONG)
# MINION_SPLIT_MAX_INPUT_BYTES=53687091200
# MINION_SPLIT_MAX_OBJECTS=10000
# MINION_SPLIT_MAX_SUBTASKS=100000
# MINION_SPLIT_MAX_SECONDS=3600         # wall-clock budget per split attempt, then back off
# MINION_SPLIT_MAX_ATTEMPTS=5            # transient split errors before the task is FAILED
# MINION_SPLIT_BACKOFF_BASE_S=2          # transient split retry backoff: doubles per attempt
# MINION_SPLIT_BACKOFF_MAX_S=300
# MINION_SPLIT_LEASE_S=900              # claim lease; a crashed split is retried after this
# MINION_HEARTBEAT_MIN_INTERVAL_S=1      # faster heartbeats per acquirement get 429; 0 disables
# MINION_RELEASE_LIMIT=10               # voluntary releases per subtask before a retryable FAILED
# MINION_EXECUTOR_HEARTBEAT_INTERVAL_S=300  # executor; keep MINION_HEARTBEAT_TIMEOUT_S >= 2-3x this
# MINION_EXECUTOR_IDLE_UNLOAD_S=600     # executor: unload the idle worker's model after this; 0 disables
# MINION_EXECUTOR_MODEL_CACHE_DIR=~/Library/Caches/open-minions/models  # executor: HF snapshots
# MINION_EXECUTOR_MODEL_CACHE_GB=50     # executor: LRU cap (Ollama store not counted)
# MINION_EXECUTOR_DOWNLOAD_TIMEOUT_S=3600  # executor: one model download; on expiry the subtask is released
# MINION_EXECUTOR_MIN_FREE_DISK_GB=10  # executor: free space a download must leave (or 10% of disk if larger)
# MINION_EXECUTOR_CONFIG=             # executor: path to executor.toml (default ~/.config/minion/executor.toml); must be owned by you and not group/world-writable
# MINION_EXECUTOR_SANDBOX=1           # executor: worker Seatbelt sandbox; 0 only with MINION_EXECUTOR_DEV=1
# MINION_EXECUTOR_FETCH_SANDBOX=1     # executor: model-fetch Seatbelt sandbox; 0 only with MINION_EXECUTOR_DEV=1
# MINION_EXECUTOR_DEV=0               # dev only: 1 enables engine `fake` and the sandbox/fetch-sandbox opt-outs
# MINION_EXECUTOR_TEST_HOOKS=0        # dev only: test hooks in the worker; needs MINION_EXECUTOR_DEV=1
# MINION_EXECUTOR_TOKEN=              # executor token (secret); prefer the Keychain item open-minions-executor
# HF_TOKEN, HTTPS_PROXY, SSL_CERT_FILE, ... are read at start and given only to the model-fetch subprocess
# Watchdog (`uv run minion-watchdog`; only MINION_DATABASE_URL is required):
# MINION_HEARTBEAT_TIMEOUT_S=900        # silent this long -> acquirement reclaimed (EXPIRED)
# MINION_MAX_LEASE_S=21600              # hard cap per acquirement, even with fresh heartbeats
# MINION_WATCHDOG_INTERVAL_S=60
# MINION_WATCHDOG_BATCH_SIZE=500
# MINION_WATCHDOG_MAX_BACKOFF_S=300   # cap on backoff after repeated DB errors
# MINION_CANCEL_SWEEP_WINDOW_S=3600     # stragglers of older cancels are healed only by re-cancel
# MINION_DB_COMMAND_TIMEOUT_S=30        # watchdog: per-statement DB timeout
# MINION_HOST=127.0.0.1
# MINION_PORT=8080
