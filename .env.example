# Local development defaults (match deploy/compose.yml). Copy to .env.
MINION_DATABASE_URL=postgresql+asyncpg://minion:minion@localhost:5432/minion
MINION_S3_ENDPOINT_URL=http://localhost:9000
MINION_S3_ACCESS_KEY=minion
MINION_S3_SECRET_KEY=minion-secret
MINION_S3_BUCKET=minion
# MINION_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000   # host executors use; defaults to the above
# MINION_S3_REGION=us-east-1
# MINION_S3_INPUT_PREFIXES=["inputs/"]    # JSON list; each must end with "/"
# MINION_S3_OUTPUT_PREFIXES=["outputs/"]
# MINION_PRESIGN_TTL_S=900                # max 3600
# MINION_MAX_OUTPUT_BYTES=4294967296      # attempt object above this is never promoted (422 OUTPUT_TOO_LARGE)
# MINION_EXECUTOR_MAX_OUTPUT_BYTES=4294967296  # executor refuses to upload more (fail OUTPUT_TOO_LARGE)
# MINION_MODELS_FILE=deploy/models.yaml
# MINION_API_KEYS_FILE=deploy/api-keys.yaml
# MINION_API_KEYS_FILE: local disk, owner root/server user, not group/world-writable; replace atomically (temp + rename)
# MINION_API_KEYS_RELOAD_S=5              # keys file change check; removed keys die within this
# MINION_SPLITTER_POLL_S=2
# MINION_EXECUTOR_TOKEN_TTL_DAYS=90
# MINION_DB_POOL_SIZE=10                 # pool_size + max_overflow = max DB connections per server
# MINION_WATCHDOG_DB_POOL_SIZE=2          # watchdog process DB pool (>= 1); set it on the server service too (budget check)
# MINION_DB_MAX_OVERFLOW=10              # process; size to the expected concurrent executor calls,
#                                        # and keep the sum below Postgres max_connections
# MINION_MAX_REQUEST_BODY_BYTES=1048576  # larger request bodies get 413
# MINION_SPLIT_MAX_LINE_BYTES=16777216   # longer JSONL line -> task FAILED (LINE_TOO_LONG)
# MINION_SPLIT_MAX_INPUT_BYTES=53687091200
# MINION_SPLIT_MAX_OBJECTS=10000
# MINION_SPLIT_MAX_SUBTASKS=100000
# MINION_SPLIT_MAX_SECONDS=3600         # wall-clock budget per split attempt, then back off
# MINION_SPLIT_MAX_ATTEMPTS=5            # transient split errors before the task is FAILED
# MINION_SPLIT_BACKOFF_BASE_S=2          # transient split retry backoff: doubles per attempt
# MINION_SPLIT_BACKOFF_MAX_S=300
# MINION_SPLIT_LEASE_S=900              # claim lease; a crashed split is retried after this
# MINION_HEARTBEAT_MIN_INTERVAL_S=1      # faster heartbeats per acquirement get 429; 0 disables
# MINION_REGISTER_MIN_INTERVAL_S=5       # min seconds between one executor's register / acquire / presence calls;
# MINION_ACQUIRE_MIN_INTERVAL_S=0.2      # faster calls get 429 TOO_MANY_REQUESTS + Retry-After (in-memory, per replica); 0 disables
# MINION_PRESENCE_MIN_INTERVAL_S=5
# MINION_PREFERENCE_MIN_INTERVAL_S=1     # PUT /executor/preference
# MINION_RATE_LIMIT_MAX_ENTRIES=40000    # limiter LRU bound (~10k executors x 4 limited ops)
# MINION_EXECUTOR_ACQUIRE_PACE_S=0.4    # executor: min seconds between acquire calls (0 or >= 0.2; 0 disables)
# MINION_EXECUTOR_FIRST_ACQUIRE_JITTER_S=15  # executor: wait uniform(0, N) after register before the first acquire (0..300; 0 disables)
# MINION_ACQUIRE_WINDOW=16             # server: claim picks at random among the top N candidates of the highest priority (1..256; 1 = strict FR-22 order, ADR-0013)
# MINION_DB_POOL_TIMEOUT_S=5           # server: max wait for a DB connection (0.5..30), then 503 SERVER_BUSY + Retry-After
# MINION_ACQUIRE_DEADLINE_S=10         # server: acquire past this before its claim INSERT answers 503 ACQUIRE_DEADLINE (1..20, below the executor's 30 s HTTP timeout)
# MINION_EXECUTOR_COMPLETE_SHED_BUDGET_S=120  # executor: wall-clock cap on retrying a complete shed with 503 + Retry-After (does not use up the retry count; then left to the watchdog)
# MINION_SERVER_WORKERS=1              # server: uvicorn worker processes (1..32); each has its own pool, acquire slots, rate limiter, splitter; pool/limits above are PER worker
# MINION_DB_MAX_CONNECTIONS=100         # server: Postgres max_connections for the startup warning (workers x (pool + overflow) + watchdog pool must stay below it minus the reserved)
# MINION_DB_RESERVED_CONNECTIONS=7      # server: connections kept for others in that check (superuser_reserved 3 + Grafana 4)
# MINION_METRICS_MULTIPROC_DIR=  # server, workers > 1: unset = private temp dir (removed on exit); if set it must be a 0700 dir you own, not a symlink (else exit 2); only its counter_/histogram_/gauge_*.db files are emptied at startup
#   (every parent directory must also be owned by you or root and not group/other-writable unless sticky)
# MINION_ACQUIRE_CONCURRENCY=          # server: concurrent acquires per process (default pool_size + max_overflow - 4, min 1); the rest get 503 SERVER_BUSY
# MINION_RELEASE_LIMIT=10              # voluntary releases per subtask before a retryable FAILED (0..100; server and watchdog must use the same value)
# MINION_EXECUTOR_HEARTBEAT_INTERVAL_S=300  # executor; keep MINION_HEARTBEAT_TIMEOUT_S >= 2-3x this
# MINION_EXECUTOR_STOP_GRACE_S=30       # executor: seconds an in-flight subtask may finish after SIGTERM/SIGINT (0..300; 0 = stop at once)
# MINION_EXECUTOR_IDLE_UNLOAD_S=600     # executor: unload the idle worker's model after this; 0 disables
# MINION_EXECUTOR_MODEL_CACHE_DIR=~/Library/Caches/open-minions/models  # executor: HF snapshots
# MINION_EXECUTOR_MODEL_CACHE_GB=50     # executor: LRU cap (Ollama store not counted)
# MINION_EXECUTOR_DOWNLOAD_TIMEOUT_S=3600  # executor: one model download; on expiry the subtask is released
# MINION_EXECUTOR_MIN_FREE_DISK_GB=10  # executor: free space a download must leave (or 10% of disk if larger)
# MINION_EXECUTOR_CONFIG=             # executor: path to executor.toml (default ~/.config/minion/executor.toml); must be owned by you and not group/world-writable
# MINION_EXECUTOR_SANDBOX=1           # executor: worker Seatbelt sandbox; 0 only with MINION_EXECUTOR_DEV=1
# MINION_EXECUTOR_FETCH_SANDBOX=1     # executor: model-fetch Seatbelt sandbox; 0 only with MINION_EXECUTOR_DEV=1
# MINION_EXECUTOR_DEV=0               # dev only: 1 enables engine `fake` and the sandbox/fetch-sandbox opt-outs
# MINION_EXECUTOR_STATE_DIR=          # owner control (pause/resume/profile) dir; default ~/Library/Application Support/open-minions
# MINION_EXECUTOR_FAKE_SIGNALS=       # dev only (needs MINION_EXECUTOR_DEV=1): absolute path of a JSON host-signals snapshot

# MINION_EXECUTOR_TEST_HOOKS=0        # dev only: test hooks in the worker; needs MINION_EXECUTOR_DEV=1
# MINION_EXECUTOR_TOKEN=              # executor token (secret); prefer the Keychain item open-minions-executor
# minion CLI (submitter; minion-cli package). Read from the real environment, not this file.
# MINION_CLI_SERVER=https://minion.example.com   # https (plain http only to loopback)
# MINION_CLI_TEAM=                     # team the submitter belongs to
# MINION_CLI_PROJECT=default
# MINION_CLI_S3_ENDPOINT_URL=          # https (http only to loopback); unset = AWS default
# MINION_CLI_S3_BUCKET=minion
# MINION_CLI_S3_REGION=us-east-1
# MINION_CLI_S3_ACCESS_KEY=            # secret; scope to inputs/{team}/ and outputs/{team}/ (S-14); unset = boto3 default chain
# MINION_CLI_S3_SECRET_KEY=            # secret; same scope
# MINION_CLI_INPUT_PREFIX=inputs/
# MINION_CLI_OUTPUT_PREFIX=outputs/
# MINION_API_KEY=                      # user API key (secret); prefer the Keychain item open-minions-api-key
# HF_TOKEN, HTTPS_PROXY, SSL_CERT_FILE, ... are read at start and given only to the model-fetch subprocess
# Watchdog (`uv run minion-watchdog`; only MINION_DATABASE_URL is required):
# MINION_HEARTBEAT_TIMEOUT_S=900        # silent this long -> acquirement reclaimed (EXPIRED)
# MINION_MAX_LEASE_S=21600              # hard cap per acquirement, even with fresh heartbeats
# MINION_WATCHDOG_INTERVAL_S=60
# MINION_WATCHDOG_BATCH_SIZE=500
# MINION_WATCHDOG_MAX_BACKOFF_S=300   # cap on backoff after repeated DB errors
# MINION_RELEASE_LIMIT=10             # free unacknowledged (NOT_ACKNOWLEDGED) expiries per subtask; 0 = every expiry counts (ADR-0014); 0..100, same value as the server
# MINION_WATCHDOG_HEALTH_FILE=         # liveness file, touched at start and after each good tick (container healthcheck; empty = off)
# Compose variables (not read by the native processes): MINION_SERVER_HOST_PORT (default 8080, 127.0.0.1 only),
# MINION_SECRETS_DIR (default ./secrets, api-keys.yaml), MINION_S3_PORT, MINION_UI_*, MINION_METRICS_TOKEN.
# Compose reads them from the shell or deploy/.env (project dir = deploy/), not from this file.
# MINION_CANCEL_SWEEP_WINDOW_S=3600     # stragglers of older cancels are healed only by re-cancel
# MINION_DB_COMMAND_TIMEOUT_S=30        # watchdog: per-statement DB timeout
# MINION_METRICS_ENABLED=false         # Prometheus /metrics on the API port (route template, method, status; acquire outcome)
# MINION_METRICS_TOKEN=                # >= 32 chars (empty = unset); if set, /metrics requires 'Authorization: Bearer <token>'
# MINION_UI_SESSION_SECRET=            # web UI (/ui): >= 32 bytes, signs the session cookie; unset = every /ui route is 404 (ADR-0010). Generate it: minion-server-admin generate-ui-secret (hand-picked phrases are weak)
# MINION_UI_SESSION_TTL_S=28800        # web UI session lifetime (60 .. 604800)
# MINION_UI_ALLOWED_HOSTS=            # optional comma list host[:port]; other Host headers get 400.; set it in production (DNS rebinding)
# MINION_GRAFANA_DB_PASSWORD=minion-grafana-dev  # compose: password of the read-only Grafana login (DEV default)
# MINION_HOST=127.0.0.1
# MINION_PORT=8080
# NF-4/NF-8/NF-9 measurements need no new settings: `minion-executor bench --budget-check | --cpu-check | --watch-reactions`
# use MINION_EXECUTOR_SIGNAL_POLL_S (default 2) and the model cache above; see docs/bench/governor-measurements.md
